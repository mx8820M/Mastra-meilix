# Template environment file for a Mastra integration.
# Copy to `.env` in your Mastra project and fill in only what you use.
# Never commit the filled-in `.env`.
# Mastra reads `.env` at startup: restart `npm run dev` after changes.

# --- Model providers (Mastra model router; see blueprint/connectors/README.md) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=          # Qwen (Alibaba)
MOONSHOT_API_KEY=           # Kimi
MINIMAX_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Storage ---
# Postgres / Supabase connection string, if you use pgvector (Q09)
DATABASE_URL=

# --- Services ---
# GitHub: use a fine-grained, read-only token for review and triage agents
GITHUB_TOKEN=
